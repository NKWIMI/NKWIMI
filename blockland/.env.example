# Copy this file to ".env" (same folder) and fill in the values.
# NEVER upload the real .env to GitHub.

# ---------- Django ----------
# Make a key with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ---------- CouchDB (http://127.0.0.1:5984) ----------
COUCHDB_USERNAME=admin
COUCHDB_PASSWORD=change-me

# ---------- Blockchain (Ganache on port 7545) ----------
GANACHE_URL=http://127.0.0.1:7545
WEB3_PROVIDER_URL=http://127.0.0.1:7545
# Printed by the deploy step (see SETUP.md, step 6)
CONTRACT_ADDRESS=
# Private key of a Ganache account (Ganache > key icon next to an account)
ETHEREUM_PRIVATE_KEY=
# Usually the FIRST Ganache account: it gives test ETH to new users
FUNDER_PRIVATE_KEY=
# Created by "npx hardhat compile" (relative to this folder)
CONTRACT_ABI_PATH=blockchain/artifacts/contracts/LandRegistry.sol/LandRegistry.json

# ---------- IPFS (Pinata, https://app.pinata.cloud > API Keys) ----------
IPFS_API_URL=https://api.pinata.cloud
IPFS_API_KEY=
IPFS_API_SECRET=
# Set to False to run without IPFS
REQUIRE_IPFS=True
